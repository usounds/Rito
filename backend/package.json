{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "target": "esnext",
  "scripts": {
    "build": "pnpm run prisma:generate && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "pnpm exec tsx --watch src/index.ts",
    "update": "pnpm up -L && pnpm install",
    "prisma:apply": "pnpm prisma migrate dev --name init",
    "prisma:generate": "pnpm prisma generate",
    "docker:build": "docker build -t rito-backend:latest .",
    "docker:run": "docker run -it --rm --name rito-backend --env-file .env rito-backend:latest",
    "docker:push": "docker buildx build --platform linux/amd64 -t ghcr.io/usounds/rito-backend:latest . --push",
    "test": "vitest run",
    "test:e2e:docker": "node e2e/docker-image.e2e.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check-missing": "tsx src/scripts/verify_posts_and_likes.ts",
    "backup-missing": "tsx src/scripts/backup_missing_to_csv.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "dependencies": {
    "@atcute/bluesky": "^4.0.20",
    "@atcute/client": "^5.1.1",
    "@atcute/lexicons": "^2.1.0",
    "@atproto/api": "^0.20.42",
    "@atproto/jwk-jose": "^0.2.4",
    "@atproto/oauth-client-node": "^0.5.4",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@skyware/jetstream": "^0.2.5",
    "dotenv": "^17.4.2",
    "openai": "^7.8.0",
    "p-limit": "^7.3.1",
    "p-queue": "^9.3.3",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/pg": "8.23.1",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.11",
    "pino-pretty": "^13.1.3",
    "prisma": "7.10.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
