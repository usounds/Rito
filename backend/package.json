{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "target": "esnext",
  "scripts": {
    "build": "pnpm run prisma:generate && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "pnpm exec tsx --watch src/index.ts",
    "dev:docker": "sh scripts/dev-docker.sh",
    "dev:db": "sh scripts/dev-db.sh start",
    "dev:db:stop": "sh scripts/dev-db.sh stop",
    "dev:db:reset": "sh scripts/dev-db.sh reset",
    "update": "pnpm up -L && pnpm install",
    "prisma:apply": "pnpm prisma migrate dev --name init",
    "prisma:generate": "pnpm prisma generate",
    "docker:build": "docker build -t rito-backend:latest .",
    "docker:run": "docker run -it --rm --name rito-backend --env-file .env rito-backend:latest",
    "docker:push": "docker buildx build --platform linux/amd64 -t ghcr.io/usounds/rito-backend:latest . --push",
    "test": "vitest run",
    "test:e2e:docker": "node e2e/docker-image.e2e.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check-missing": "tsx src/scripts/verify_posts_and_likes.ts",
    "backup-missing": "tsx src/scripts/backup_missing_to_csv.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "dependencies": {
    "@atcute/bluesky": "^4.0.24",
    "@atcute/client": "^5.1.2",
    "@atcute/lexicons": "^2.1.1",
    "@atproto/api": "^0.28.1",
    "@atproto/jwk-jose": "^0.2.4",
    "@atproto/oauth-client-node": "^0.5.10",
    "@bsky/jetstream": "^1.0.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.8",
    "openai": "^7.39.0",
    "p-limit": "^7.3.3",
    "p-queue": "^10.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.0.5",
    "pino-pretty": "^13.2.0",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
