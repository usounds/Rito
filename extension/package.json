{
  "name": "rito-extension",
  "version": "1.2.7",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "description": "Rito's browser extension for bookmarking.",
  "private": true,
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "update": "pnpm dlx npm-check-updates -u && pnpm install && pnpm update",
    "build": "wxt build && wxt build -b firefox",
    "zip": "wxt zip && wxt zip -b firefox --sources",
    "postinstall": "wxt prepare",
    "compile": "tsc --noEmit",
    "submit:chrome": "dotenv -e .env.submit -- npx publish-browser-extension@5.1.0 --chrome-zip .output/rito-extension-$(node -p \"require('./package.json').version\")-chrome.zip",
    "submit:firefox": "dotenv -e .env.submit -- npx publish-browser-extension@5.1.0 --firefox-zip .output/rito-extension-$(node -p \"require('./package.json').version\")-firefox.zip --firefox-sources-zip .output/rito-extension-$(node -p \"require('./package.json').version\")-sources.zip",
    "lex-gen": "lex-cli generate -c ./lex.config.js"
  },
  "dependencies": {
    "@atcute/bluesky-richtext-builder": "^4.0.1",
    "@atcute/client": "^5.1.1",
    "@atcute/lexicons": "^2.0.3",
    "@atcute/tid": "^1.1.4",
    "heroicons": "^2.2.0",
    "tinyld": "^1.3.4"
  },
  "devDependencies": {
    "@atcute/lex-cli": "^3.2.1",
    "@types/chrome": "^0.2.5",
    "@types/node": "^26.1.2",
    "dotenv-cli": "^11.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "wxt": "^0.21.3"
  }
}
